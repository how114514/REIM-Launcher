{
  "id": "M3A-A6-01",
  "description": "A6: one model instance with Runtime parts and the spike sound event",
  "flags": ["channel_spike"],
  "ui_canvas": [1280, 720, 2],
  "timeout_ms": 20000,
  "steps": [
    { "wait_ticks": 3 },
    { "fetch_frames": 4 }
