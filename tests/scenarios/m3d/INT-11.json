{
  "id": "INT-11",
  "description": "Held mining (BREAK_START) progresses from the Runtime target and finishes",
  "spawn": [16.5, 100.0, 80.5],
  "spawn_yaw": 0.0,
  "spawn_pitch": 90.0,
  "render_distance": 2,
  "ui_canvas": [1280, 720, 2],
  "timeout_ms": 30000,
  "setup": [
    { "action": "clear_inventory" },
    { "action": "give", "item": "minecraft:stone_pickaxe", "count": 1 },
    { "action": "set_block", "x": 15, "y": 99, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 99, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 99, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 15, "y": 99, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 99, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 99, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 15, "y": 99, "z": 81, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 99, "z": 81, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 99, "z": 81, "block": "minecraft:stone" },
    { "action": "set_block", "x": 15, "y": 98, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 98, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 98, "z": 79, "block": "minecraft:stone" },
    { "action": "set_block", "x": 15, "y": 98, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 98, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 98, "z": 80, "block": "minecraft:stone" },
    { "action": "set_block", "x": 15, "y": 98, "z": 81, "block": "minecraft:stone" },
    { "action": "set_block", "x": 16, "y": 98, "z": 81, "block": "minecraft:stone" },
    { "action": "set_block", "x": 17, "y": 98, "z": 81, "block": "minecraft:stone" }
  ],
  "probes": [[16, 99, 80]],
  "steps": [
    { "wait_ticks": 3 },
    { "action": { "type": "break_start" } },
    { "wait_ticks": 25 },
    { "action": { "type": "break_stop" } },
    { "wait_ticks": 2 },
    { "fetch_frames": 2 }
  ],
  "assert": [
    { "type": "block_at", "x": 16, "y": 99, "z": 80, "state": "minecraft:air" },
    { "type": "status_at_least", "path": "gameplay.counters.blocks_broken", "value": 1 }
  ]
}
