{
  "id": "MOB-09",
  "description": "Entity load: 40 ticking mobs keep the simulation at 20 TPS",
  "spawn": [16.5, 100.0, 80.5],
  "spawn_yaw": 0.0,
  "spawn_pitch": 90.0,
  "render_distance": 2,
  "ui_canvas": [1280, 720, 2],
  "timeout_ms": 40000,
  "setup": [
    { "action": "clear_inventory" },
    { "action": "platform", "x": 16, "y": 99, "z": 80, "radius": 8 },
    { "action": "spawn_entity", "entity": "cow", "x": 10, "y": 100, "z": 74, "count": 40 }
  ],
  "steps": [
    { "wait_ticks": 80 },
    { "fetch_frames": 2 }
  ],
  "assert": [
    { "type": "entity_count_at_least", "value": 40 },
    { "type": "status_at_least", "path": "measured_tps", "value": 15.0 }
  ]
}
