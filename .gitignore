.idea/
*.iml
.DS_Store
Thumbs.db

# Build outputs
build/
generated/
work/
logs/
*.log
*.pdb
*.ilk
*.obj
*.exe
*.dll
*.lib
*.exp

# Local IDE state
.vs/
out/

# Generated inspection reports (use --out under build/ or a temp directory)
inspect-world.json
inspect-world-rerun.json

# Mojang metadata/library files downloaded during setup; never commit Mojang files (M1-D06)
version_manifest_v2.json
versions/
libraries/

# Python caches
__pycache__/
*.pyc

# UE project transients (M2-A7); Content/*.uasset|*.umap are committed via LFS
runtime/host/Binaries/
runtime/host/Intermediate/
runtime/host/Saved/
runtime/host/DerivedDataCache/
runtime/host/Build/
runtime/host/Plugins/*/Binaries/
runtime/host/Plugins/*/Intermediate/
runtime/host/Plugins/*/Saved/
runtime/host/*.sln
runtime/host/*.suo
runtime/host/*.opensdf
runtime/host/*.sdf
runtime/host/*.VC.db
